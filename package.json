{
  "name": "valorant-vault",
  "version": "0.1.0",
  "private": true,
  "scripts": {
      "dev": "next dev",
      "build": "next build",
      "start": "next start",
      "lint": "eslint .",
      "typecheck": "tsc --noEmit",
      "format": "prettier --write .",
      "format:check": "prettier --check .",
      "test": "vitest run",
      "test:watch": "vitest",
      "test:e2e": "playwright test",
      "verify": "npm run lint && npm run typecheck && npm test && npm run build"
    },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prettier": "^3.9.9",
    "typescript": "^5",
    "vitest": "^4.1.11"
  }
}
